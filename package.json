{
  "name": "sirius-cloud-platform",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "npm run dev --workspace=@sirius/web",
    "dev:api": "npm run dev --workspace=@sirius/api",
    "build": "prisma generate && turbo run build",
    "start": "turbo run start --parallel",
    "start:web": "npm run start --workspace=@sirius/web",
    "start:api": "npm run start --workspace=@sirius/api",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "prisma": "^6.19.0",
    "typescript": "^5.7.3",
    "turbo": "^2.11.13"
  },
  "allowScripts": {
    "@prisma/client@6.19.0": true,
    "prisma@6.19.0": true,
    "@prisma/engines@6.19.0": true
  }
}
